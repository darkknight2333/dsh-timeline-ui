{
  "name": "dsh-timeline-ui",
  "version": "0.1.0",
  "description": "Date-grouped conversation list and a left-side conversation rail with fisheye hover for the DeepSeek Harness Web UI.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "timeline"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "verify": "npm run build && npm test",
    "pack": "npm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkknight2333/dsh-timeline-ui.git"
  },
  "homepage": "https://github.com/darkknight2333/dsh-timeline-ui#readme",
  "bugs": {
    "url": "https://github.com/darkknight2333/dsh-timeline-ui/issues"
  }
}
